<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 14+ refuses to schedule a job that waits for a network without this -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- lets queued captures survive a reboot (JobInfo.setPersisted) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- the buzz when the mic opens and on Done, which plays even with system vibration off -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- SMS is one optional way to reach a partner; without this a phone radio would be required to install at all -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- Android 11+ hides the speech service from SpeechRecognizer without this -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- no backup: prefs hold the Microsoft refresh token and the Gemini key -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Capture"
        android:theme="@style/Theme.Capture">

        <activity
            android:name=".CaptureActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode|fontScale"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Capture settings" />

        <receiver
            android:name=".StickyWidget"
            android:exported="false"
            android:label="Capture sticky note">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sticky_widget" />
            <meta-data
                android:name="com.samsung.android.appwidget.provider"
                android:resource="@xml/sticky_widget_samsung" />
        </receiver>

        <service
            android:name=".SaveJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- predictive back off: on Android 16 it would skip onBackPressed, so swiping back dropped you into the feed uncounted -->
        <activity
            android:name=".GuardActivity"
            android:enableOnBackInvokedCallback="false"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance" />

        <service
            android:name=".GuardService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/guard_service" />
        </service>
    </application>
</manifest>
