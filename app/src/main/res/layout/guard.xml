<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink_ground"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/guardLabel"
            style="@style/Capture.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GUARD · FOCUS" />

        <LinearLayout
            android:id="@+id/guardStrip"
            android:layout_width="wrap_content"
            android:layout_height="6dp"
            android:layout_marginTop="10dp"
            android:importantForAccessibility="yes"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/headline"
            style="@style/Capture.Now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/reason"
            style="@style/Capture.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="@color/ink_faint" />

        <TextView
            android:id="@+id/focusCommitment"
            style="@style/Capture.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/nextAction"
            style="@style/Capture.Said"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnReturnToTask"
            style="@style/Capture.HairlineButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Return to task" />

        <Button
            android:id="@+id/btnCaptureThought"
            style="@style/Capture.HairlineButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Capture a thought first" />

        <LinearLayout
            android:id="@+id/purposeContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnImportant"
                style="@style/Capture.HairlineButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="I'm doing something important" />

            <LinearLayout
                android:id="@+id/purposeInputGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/purposeInput"
                    style="@style/Capture.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/field_underline"
                    android:hint="State your purpose (e.g. reply to Alex about lab)"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:paddingVertical="12dp"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/btnGrantPass"
                    style="@style/Capture.HairlineButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Grant 5m pass" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/leisureContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnLeisure"
                style="@style/Capture.HairlineButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Take 5m leisure" />
        </LinearLayout>

        <TextView
            android:id="@+id/supportiveBanner"
            style="@style/Capture.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/countdownContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/countdownText"
                style="@style/Capture.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCountdownReturn"
                    style="@style/Capture.HairlineButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="Return to task" />

                <View
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/btnCountdownCancel"
                    style="@style/Capture.HairlineButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="False positive, cancel" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
