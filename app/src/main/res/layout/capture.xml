<?xml version="1.0" encoding="utf-8"?>
<!-- compact: the cover screen (about 400 x 440dp). Same ids as layout-h600dp/capture.xml, smaller everything -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink_ground"
    android:fitsSystemWindows="true"
    android:keepScreenOn="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:paddingHorizontal="18dp"
    android:paddingTop="6dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/catalog"
                style="@style/Capture.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/strip"
                android:layout_width="wrap_content"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:importantForAccessibility="yes"
                android:orientation="horizontal" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/ring_button"
            android:contentDescription="Settings"
            android:src="@drawable/ic_tune" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        style="@style/Capture.Hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:accessibilityLiveRegion="polite"
        android:ellipsize="end"
        android:maxLines="2"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/said"
        style="@style/Capture.Said"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:accessibilityLiveRegion="polite"
        android:maxLines="2"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- typing has its own field, so a late Gemini correction of a spoken sentence can never overwrite typed words -->
    <EditText
        android:id="@+id/typed"
        style="@style/Capture.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/field_underline"
        android:hint="Type here"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textCapSentences"
        android:maxLines="2"
        android:paddingVertical="8dp"
        android:textSize="15sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/now"
        style="@style/Capture.Now"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="2dp"
        android:accessibilityLiveRegion="polite"
        android:autoSizeMaxTextSize="24sp"
        android:autoSizeMinTextSize="15sp"
        android:autoSizeTextType="uniform"
        android:gravity="top"
        android:hint="Start talking"
        android:maxLines="2" />

    <app.thoughtcapturer.PulsePlotView
        android:id="@+id/plot"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:minHeight="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/cancel"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/ring_button"
            android:contentDescription="Cancel and discard"
            android:src="@drawable/ic_close" />

        <ImageButton
            android:id="@+id/done"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginHorizontal="28dp"
            android:background="@drawable/done_button"
            android:contentDescription="Done, save this capture"
            android:scaleType="center"
            android:src="@drawable/ic_check"
            android:tint="@color/ink_ground" />

        <ImageButton
            android:id="@+id/type"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/ring_button"
            android:contentDescription="Type instead"
            android:src="@drawable/ic_keyboard" />
    </LinearLayout>
</LinearLayout>
</FrameLayout>
