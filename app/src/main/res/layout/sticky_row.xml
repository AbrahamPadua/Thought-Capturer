<?xml version="1.0" encoding="utf-8"?>
<!-- blocksDescendants: a focusable ImageButton inside a list row otherwise swallows the row's own tap -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:descendantFocusability="blocksDescendants"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/barlow_medium"
            android:maxLines="3"
            android:textColor="@color/ink_line"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/points"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/barlow_regular"
            android:maxLines="4"
            android:textColor="@color/ink_muted"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 48dp: a thumb-sized target on the small cover screen -->
    <ImageButton
        android:id="@+id/clear"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/ring_button"
        android:contentDescription="Clear"
        android:scaleType="center"
        android:src="@drawable/ic_check" />
</LinearLayout>
