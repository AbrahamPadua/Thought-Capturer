<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- one dark theme: the matte black is the world, not a night mode -->
    <style name="Theme.Capture" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink_ground</item>
        <item name="android:colorBackground">@color/ink_ground</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/ink_line</item>
        <item name="android:colorControlNormal">@color/ink_muted</item>
        <item name="android:colorControlActivated">@color/ink_line</item>
        <item name="android:colorControlHighlight">#33F2F2F2</item>
        <item name="android:textColorPrimary">@color/ink_line</item>
        <item name="android:textColorSecondary">@color/ink_muted</item>
        <item name="android:textColorHint">@color/ink_muted</item>
        <item name="android:textColorHighlight">#664F9DDE</item>
        <item name="android:fontFamily">@font/barlow_regular</item>
    </style>

    <!-- parent of the Capture.* text styles below (dotted names inherit from it) -->
    <style name="Capture" />

    <style name="Capture.Label">
        <item name="android:fontFamily">@font/barlow_condensed_semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.28</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/ink_line</item>
    </style>

    <style name="Capture.Title">
        <item name="android:fontFamily">@font/barlow_condensed_semibold</item>
        <item name="android:textSize">34sp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/ink_line</item>
    </style>

    <style name="Capture.Hint">
        <item name="android:fontFamily">@font/barlow_regular</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ink_muted</item>
    </style>

    <style name="Capture.Said">
        <item name="android:fontFamily">@font/barlow_regular</item>
        <item name="android:textSize">20sp</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
        <item name="android:textColor">@color/ink_muted</item>
    </style>

    <style name="Capture.Now">
        <item name="android:fontFamily">@font/barlow_medium</item>
        <item name="android:textSize">32sp</item>
        <item name="android:lineSpacingMultiplier">1.02</item>
        <item name="android:textColor">@color/ink_line</item>
    </style>

    <style name="Capture.Body">
        <item name="android:fontFamily">@font/barlow_regular</item>
        <item name="android:textSize">17sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:textColor">@color/ink_line</item>
    </style>

    <style name="Capture.Code">
        <item name="android:fontFamily">@font/barlow_condensed_semibold</item>
        <item name="android:textSize">44sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/ink_line</item>
    </style>

    <style name="Capture.HairlineButton">
        <item name="android:background">@drawable/hairline_rect</item>
        <item name="android:fontFamily">@font/barlow_condensed_semibold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/ink_line</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
