<?xml version="1.0" encoding="utf-8"?>
<!-- only the bottom edge shows: the other three are pushed outside the bounds -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item android:left="-3dp" android:right="-3dp" android:top="-3dp">
                <shape><stroke android:width="1.5dp" android:color="@color/ink_line" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:left="-3dp" android:right="-3dp" android:top="-3dp">
                <shape><stroke android:width="1.5dp" android:color="@color/ink_muted" /></shape>
            </item>
        </layer-list>
    </item>
</selector>
